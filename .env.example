# ═══════════════════════════════════════════════════════════════
# EcoTrace Phase 2 — Environment Variables
# Copy to .env and fill in values
# ═══════════════════════════════════════════════════════════════

# Database
POSTGRES_PASSWORD=your_secure_postgres_password_here

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY_MINUTES=60

# Bootstrap Token (for device registration)
BOOTSTRAP_TOKEN=your_bootstrap_token_here

# Admin Token (for device revocation via /admin/revoke)
ADMIN_TOKEN=your_admin_token_here

# Services
AUTH_SERVICE_URL=http://auth-service:3001
DATABASE_URL=postgresql://ecotrace:${POSTGRES_PASSWORD}@postgres:5432/ecotrace
