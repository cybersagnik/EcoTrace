# ════════════════════════════════════════════════════════════════════════════
# EcoTrace — Production environment template
# Copy to `/.env` at the repo root, fill in secrets, never commit.
# ════════════════════════════════════════════════════════════════════════════

# ─── Public URL exposed by the localhost.run tunnel ────────────────────────
# Fill this in after the FIRST successful tunnel run (look in
# `journalctl -u ecotrace-tunnel` for the assigned *.lhr.life hostname).
TUNNEL_PUBLIC_URL=

# ─── nginx host ports ──────────────────────────────────────────────────────
NGINX_PORT_HTTP=80
NGINX_PORT_HTTPS=443

# ─── Database ──────────────────────────────────────────────────────────────
# Replace with a strong random string.
POSTGRES_PASSWORD=CHANGE_ME_generate_a_strong_postgres_password

# ─── JWT (auth-service + registration-service) ─────────────────────────────
# Replace with a strong random secret (≥32 bytes base64 recommended).
JWT_SECRET=CHANGE_ME_generate_a_strong_jwt_secret
JWT_EXPIRY_MINUTES=60

# ─── Bootstrap & admin tokens ──────────────────────────────────────────────
# BOOTSTRAP_TOKEN: presented by a device at /register
BOOTSTRAP_TOKEN=CHANGE_ME_bootstrap_token
# ADMIN_TOKEN: presented by an admin to /admin/revoke/*
ADMIN_TOKEN=CHANGE_ME_admin_token

# ─── CORS for the REST API (comma-separated origins) ───────────────────────
# Add the tunnel URL once it is known.
CORS_ALLOWED_ORIGINS=http://localhost,https://localhost,http://127.0.0.1,https://127.0.0.1

# ─── Internal-only URLs (read by docker-compose) ───────────────────────────
NATS_URL=nats://nats:4222
