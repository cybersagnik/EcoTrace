# ═══════════════════════════════════════════════════════════════
# EcoTrace Frontend — Environment Variables (Docker / production)
# ═══════════════════════════════════════════════════════════════

# Public (browser-visible) — base URL for the Next.js API proxy routes.
# Same-origin in the Docker setup; nginx routes /api/* to the backend.
NEXT_PUBLIC_API_BASE_URL=

# Server-side (Next.js) — backend service URLs reachable inside the
# ecotrace Docker network. Used by the app/api/* proxy routes.
BACKEND_API_URL=http://api:3003
AUTH_SERVICE_URL=http://auth-service:3001

# Public WebSocket URL — left empty so client uses same-origin wss://
NEXT_PUBLIC_WS_URL=
